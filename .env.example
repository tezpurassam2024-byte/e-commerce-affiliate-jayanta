# GEMINI_API_KEY: Required for server-side Gemini AI editorial assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional for cloud sync; local storage fallback works seamlessly)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=""

# Amazon Associates Settings
AMAZON_ASSOCIATE_TAG="smartpick-20"
AMAZON_MARKETPLACE="amazon.com"

